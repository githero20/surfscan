{
  "name": "surfscan",
  "version": "0.2.0",
  "description": "Attack surface scanner for AI-assisted development",
  "keywords": [
    "ai",
    "security",
    "mcp",
    "rag",
    "prompt-injection",
    "llm",
    "scanner"
  ],
  "license": "MIT",
  "author": "Omogbai Atakpu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githero20/surfscan.git"
  },
  "bugs": {
    "url": "https://github.com/githero20/surfscan/issues"
  },
  "homepage": "https://github.com/githero20/surfscan#readme",
  "type": "module",
  "bin": {
    "surfscan": "dist/cli/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
